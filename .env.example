# ─────────────────────────────────────────────────────────────
# Public site configuration
# ─────────────────────────────────────────────────────────────
# Canonical URL used for metadata, sitemap and Open Graph tags.
# Optional: if empty, Vercel's production domain is used automatically.
NEXT_PUBLIC_SITE_URL=https://www.aanuragmishra.com

# Character renderer for the 3D scene. One of:
#   sprite      – transparent sprite sheet (default, works in every browser)
#   video       – transparent .webm (VP9 alpha) played as a texture
#   gltf        – rigged .glb model with a walk animation clip
#   placeholder – procedural capsule mannequin (no asset needed)
# Leave empty to use the value in src/lib/characterConfig.ts.
NEXT_PUBLIC_CHARACTER_MODE=

# ─────────────────────────────────────────────────────────────
# Contact form (server-only). If RESEND_API_KEY is empty the form
# gracefully falls back to opening the visitor's mail client.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=anuragmishra101@gmail.com
# Must be a sender on a domain verified in Resend.
CONTACT_FROM_EMAIL=Portfolio <no-reply@aanuragmishra.com>
# Optional extra origins allowed to POST to /api/contact (comma-separated).
# The site's own domain is always allowed, including *.vercel.app deployments.
CONTACT_ALLOWED_ORIGINS=https://www.aanuragmishra.com,http://localhost:3000
